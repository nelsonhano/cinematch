# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings (choose one)
OPENAI_API_KEY=sk-...           # for text-embedding-3-small
# or VOYAGE_API_KEY=...         # for Voyage 3

# TMDB
TMDB_API_KEY=...                # v3 API key
TMDB_ACCESS_TOKEN=eyJ...        # v4 bearer token (optional)

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRO_PRICE_ID=price_...

# Email (SMTP via Nodemailer). Gmail needs 2 step verification plus an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                   # 465 (implicit TLS) or 587 (STARTTLS)
SMTP_USER=you@gmail.com
SMTP_PASS=abcdabcdabcdabcd      # Gmail app password, not your account password
EMAIL_FROM="CineMatch <you@gmail.com>"   # must match SMTP_USER (or a verified alias) on Gmail

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App
NEXT_PUBLIC_APP_URL=https://cinematch.app
CRON_SECRET=...                 # verify cron job requests
